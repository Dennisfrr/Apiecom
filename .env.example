# Números autorizados (somente dígitos, separados por vírgula).
# Exemplo: 5511999999999
AUTHORIZED_WHATSAPP_NUMBERS=
APP_BASE_URL=https://localhost:3030
WPP_SESSION=gestao-estoque
AGENT_PASSWORD=

# Gere esta chave no painel da DeepSeek. Ela fica apenas no seu .env local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Assinatura HMAC dos webhooks do Bling. Use o client secret do aplicativo
# configurado no Bling; nunca exponha este valor no navegador.
BLING_WEBHOOK_SECRET=

# Funil de ofertas. Use uma chave longa e aleatória.
FUNNEL_ADMIN_TOKEN=
# Número que recebe as compras no privado, com DDI e DDD, somente dígitos.
FUNNEL_SALES_NUMBER=
# Número interno que recebe alertas de intenção de compra/handoff.
FUNNEL_OPERATOR_NUMBER=
# URL pública HTTPS que redireciona para o WhatsApp (domínio ou ngrok).
FUNNEL_PUBLIC_BASE_URL=https://seu-dominio.example
# Intervalo de verificação da fila de publicações.
OFFER_POLL_INTERVAL_MS=15000

# Agente comercial separado. O WPPConnect usa menus numéricos, sem botões.
WPP_GROUP_SESSION=vendas-grupo-puket
GROUP_AGENT_TOKEN=
GROUP_SALES_NUMBER=
GROUP_PUBLIC_BASE_URL=https://seu-dominio.example
# Mantém o atendimento comercial fora do agente interno de estoque.
ENABLE_LEGACY_FUNNEL=false
# Backend e hospedagem
NODE_ENV=development
PORT=3030
# Em produção, informe o domínio publicado pelo Lovable, sem barra no final.
# Para mais de um domínio, separe por vírgulas.
ALLOWED_ORIGINS=https://seu-site.lovable.app
# O frontend antigo só deve ser servido durante o desenvolvimento local.
SERVE_FRONTEND=true

# Integrações Linx, Bling e Gemini. Cadastre estes valores como secrets no Railway.
# Token operacional opcional para compatibilidade. O login automático abaixo
# passa a ser a fonte principal e renova o JWT antes do vencimento.
LINX_TOKEN=
LINX_LOGIN=
LINX_PASSWORD=
LINX_PORTAL_ID=7776
LINX_COMPANY_ID=1
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=https://seu-backend.up.railway.app/bling/callback
GEMINI_API_KEY=
